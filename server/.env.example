# Love BUDS — sample-request mailer
#
# Copy this file to `.env` and fill in the real values.
#   cp .env.example .env
#
# `.env` is git-ignored and must NEVER be committed. These values are read
# only on the server; nothing here is ever sent to the browser.

# ---- SMTP transport ---------------------------------------------------------
# Any SMTP provider works. Some common hosts:
#   Postmark   smtp.postmarkapp.com        port 587
#   SendGrid   smtp.sendgrid.net           port 587   (user is literally "apikey")
#   Mailgun    smtp.mailgun.org            port 587
#   Google     smtp.gmail.com              port 587   (requires an App Password)
SMTP_HOST=smtp.example.com
SMTP_PORT=587
# true for port 465 (implicit TLS), false for 587 (STARTTLS)
SMTP_SECURE=false
SMTP_USER=replace-me
SMTP_PASS=replace-me

# ---- Addressing -------------------------------------------------------------
# MAIL_FROM must be a domain the SMTP account is allowed to send as, or the
# provider will reject the message.
MAIL_FROM="Love BUDS Website <no-reply@aussieplantbased.com>"
# Where sample requests land. Comma-separate for several recipients.
MAIL_TO=orders@aussieplantbased.com
# Optional: replies go to the person who filled in the form when this is true.
REPLY_TO_SUBMITTER=true

# ---- Server -----------------------------------------------------------------
PORT=8787
NODE_ENV=development

# Browsers may only POST from these origins. Comma-separate, no trailing slash.
# Use the real site origin in production, e.g. https://buds.joevin.tech
ALLOWED_ORIGINS=http://localhost:3000,https://buds.joevin.tech

# Max submissions per IP per window (window is 15 minutes).
RATE_LIMIT_MAX=5
