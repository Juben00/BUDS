SMTP_HOST=smtp.example.com
SMTP_PORT=587
# true for port 465 (implicit TLS), false for 587 (STARTTLS)
SMTP_SECURE=false
SMTP_USER=replace-me
SMTP_PASS=replace-me

MAIL_FROM="Love BUDS Website <no-reply@aussieplantbased.com>"
# Comma-separate for multiple recipients
MAIL_TO=orders@aussieplantbased.com
REPLY_TO_SUBMITTER=true

PORT=8787
NODE_ENV=development

# Comma-separated site origins allowed to POST, no trailing slash
ALLOWED_ORIGINS=http://localhost:3000

# Max submissions per IP per 15 minutes
RATE_LIMIT_MAX=5
